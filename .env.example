# Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git (it's in .gitignore)

# ============================================================================
# VERCEL POSTGRES (NEON) - Required
# ============================================================================

# Get this from: Vercel Dashboard → Storage → Your Database → Settings
# IMPORTANT: Use POSTGRES_URL_NON_POOLING (direct connection, not pooled)
# Format: postgresql://username:password@host:5432/dbname?sslmode=require
VERCEL_POSTGRES_URL=postgresql://user:password@aws-0-us-east-1.neon.tech:5432/dbname?sslmode=require

# ============================================================================
# HUGGING FACE - Required for AutoTrain and Model Uploads
# ============================================================================

# Get this from: https://huggingface.co/settings/tokens
# Permissions needed: Read + Write (to upload models and datasets)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# NLP MEDICAL BILLING CODE SYSTEM - New Configuration
# ============================================================================

# Model Configuration
EMBEDDING_MODEL=NeuML/bioclinical-modernbert-base-embeddings
CONFIDENCE_THRESHOLD=0.85
CONSENSUS_THRESHOLD=0.70

# Processing
BATCH_SIZE=64
MAX_WORKERS=4

# ============================================================================
# OPTIONAL - For Advanced Features
# ============================================================================

# MIMIC-IV PhysioNet credentials (after credentialing)
# Only needed if you plan to download MIMIC-IV data
# PHYSIONET_USERNAME=your_username
# PHYSIONET_PASSWORD=your_password

# OpenAI API key (if you want to use GPT models for code suggestions)
# Only needed for advanced NLP experiments
# OPENAI_API_KEY=sk-...

# Pinecone API key (if you migrate from pgvector to Pinecone)
# Only needed if database exceeds 1M embeddings
# PINECONE_API_KEY=...
# PINECONE_ENVIRONMENT=us-east-1-aws

# ============================================================================
# DEEPNOTE USAGE (Recommended)
# ============================================================================

# For Deepnote, DO NOT use this .env file for credentials
# Instead, use Environment Variables in Project Settings:
# 1. Open your Deepnote project
# 2. Click gear icon (⚙️) for Project Settings
# 3. Navigate to "Environment Variables" tab
# 4. Click "+ Add variable"
# 5. Add:
#    - Name: VERCEL_POSTGRES_URL
#    - Value: postgresql://... (paste your connection string)
#    - Scope: Project (default)
# 6. Repeat for HF_TOKEN
# 7. Variables are automatically available via os.getenv()

# Benefits of Deepnote Environment Variables:
# - Encrypted at rest and in transit
# - Never exposed in notebook output
# - Shared across all notebooks in project
# - Version controlled separately from code
# - Can be scoped to specific environments (dev/prod)

# ============================================================================
# LOCAL DEVELOPMENT
# ============================================================================

# For local Python scripts (not Deepnote), you can use this .env file:
#
#   from dotenv import load_dotenv
#   import os
#
#   load_dotenv()
#   DATABASE_URL = os.getenv('VERCEL_POSTGRES_URL')
#

