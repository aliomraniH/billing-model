# Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git (it's in .gitignore)

# ============================================================================
# VERCEL POSTGRES (NEON) - Required
# ============================================================================

# Get this from: Vercel Dashboard → Storage → Your Database → Settings
# IMPORTANT: Use POSTGRES_URL_NON_POOLING (direct connection, not pooled)
# Format: postgresql://username:password@host:5432/dbname?sslmode=require
VERCEL_POSTGRES_URL=postgresql://user:password@aws-0-us-east-1.neon.tech:5432/dbname?sslmode=require

# ============================================================================
# HUGGING FACE - Required for AutoTrain and Model Uploads
# ============================================================================

# Get this from: https://huggingface.co/settings/tokens
# Permissions needed: Read + Write (to upload models and datasets)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# OPTIONAL - For Advanced Features
# ============================================================================

# MIMIC-IV PhysioNet credentials (after credentialing)
# Only needed if you plan to download MIMIC-IV data
# PHYSIONET_USERNAME=your_username
# PHYSIONET_PASSWORD=your_password

# OpenAI API key (if you want to use GPT models for code suggestions)
# Only needed for advanced NLP experiments
# OPENAI_API_KEY=sk-...

# Pinecone API key (if you migrate from pgvector to Pinecone)
# Only needed if database exceeds 1M embeddings
# PINECONE_API_KEY=...
# PINECONE_ENVIRONMENT=us-east-1-aws

# ============================================================================
# GOOGLE COLAB USAGE
# ============================================================================

# For Google Colab, DO NOT use this .env file
# Instead, use Colab Secrets (🔑 sidebar):
# 1. Click 🔑 Secrets in left sidebar
# 2. Add secret: VERCEL_POSTGRES_URL
# 3. Add secret: HF_TOKEN
# 4. Toggle "Notebook access" ON

